# Opcional: stack de backend preservada, fora do MVP estático.
# O MVP não precisa de .env nem de API/banco em execução.
# Apenas desenvolvimento local. Nunca use estas credenciais em produção.
POSTGRES_USER=jyboia
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=jyboia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jyboia:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/jyboia?schema=public
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Variáveis VITE_ são públicas; nunca incluir segredos.
VITE_API_URL=http://127.0.0.1:3001
